APP_NAME=AI DataShield
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./aidatashield.db
# Real breach source (HIBP). Set MOCK_BREACH_MODE=false to use this.
HIBP_API_KEY=
HIBP_BASE_URL=https://haveibeenpwned.com/api/v3
MOCK_BREACH_MODE=true
MOCK_BREACH_DB_PATH=app/data/mock_breach_db.json
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
BREACH_MONITOR_ENABLED=true
BREACH_MONITOR_INTERVAL_SECONDS=60
SMTP_ENABLED=false
SMTP_SENDER=noreply@aidatashield.local
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
ALLOWED_ORIGINS=*
